# Local defaults only. Replace through your ignored .env file for any real deployment.
POSTGRES_DB=squadra
POSTGRES_USER=squadra
POSTGRES_PASSWORD=squadra_local_only
JWT_SIGNING_KEY=replace-with-a-32-byte-local-development-secret
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
SQUADRA_API_URL=http://api:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-32-byte-local-development-nextauth-secret
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
